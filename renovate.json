{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
        "customType": "regex",
        "managerFilePatterns": [
        "/\\.yaml$/"
      ],
        "matchStrings": [
            "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+_VERSION=(?<currentValue>\\S+)"
        ],
        "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
